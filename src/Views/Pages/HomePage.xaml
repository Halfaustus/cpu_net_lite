<Page x:Class="cpu_net.Views.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:cpu_net.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="HomePage">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Top">
            <Button Content="立即登录" Name="LoginButton" Command="{Binding LoginButton_Click}" FontSize="16" Width="120" Height="40" Margin="0,0,0,10" Click="LoginButton_Click"/>
            <Button Content="运营商绑定" Name="BindButton" Command="{Binding BindButton_Click}" FontSize="16" Width="120" Height="40"/>
            <Button Content="清空日志" Command="{Binding ClearLogCommand}" FontSize="16" Width="120" Height="40" Margin="0,10,0,0"
                    ToolTip="清空当前显示的日志，保留磁盘历史文件；重启后会重新加载历史日志。"/>
        </StackPanel>
        <Grid Grid.Column="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Name="sv1" Background="#CCFFFFFF">
                <TextBox Name="textLog" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True" IsReadOnlyCaretVisible="True" Text="{Binding TxtLog, Mode=OneWay}" TextChanged="textLog_TextChanged" PreviewKeyDown="Log_PreviewKeyDown" BorderBrush="{x:Null}">
                    <TextBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="复制选中内容" Click="CopySelectedLog_Click"/>
                            <MenuItem Header="复制全部日志" Click="CopyAllLog_Click"/>
                            <Separator/>
                            <MenuItem Header="全选" Click="SelectAllLog_Click"/>
                        </ContextMenu>
                    </TextBox.ContextMenu>
                </TextBox>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
