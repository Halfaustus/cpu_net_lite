<Page x:Class="cpu_net.Views.Pages.ConfigurationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:cpu_net.Views.Pages"
      xmlns:vm="clr-namespace:cpu_net.ViewModel"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ConfigurationPage">
    <Page.Resources>
        <vm:CarrierViewModel x:Key="carrierVM"/>
        <Style x:Key="ModuleSaveButton" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- 左侧菜单 -->
        <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" Background="#CCF5F5F5">
            <ListBox x:Name="MenuListBox" BorderThickness="0" Background="Transparent">
                <ListBoxItem Content="网络设置" Tag="network" IsSelected="True" Padding="15,10" FontSize="14"/>
                <ListBoxItem Content="日志配置" Tag="logging" Padding="15,10" FontSize="14"/>
                <ListBoxItem Content="关于" Tag="about" Padding="15,10" FontSize="14"/>
            </ListBox>
        </Border>
        
        <!-- 右侧内容区 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" x:Name="ContentScrollViewer">
                <StackPanel Margin="12">
                    
                    <!-- 网络设置面板 -->
                    <Grid x:Name="NetworkPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="网络设置" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                        
                        <CheckBox Grid.Row="1" Name="NetworkEnabledCheckBox" Content="启用网络登录" FontSize="14" Margin="0,0,0,15" Checked="ImmediateOption_Changed" Unchecked="ImmediateOption_Changed"/>
                        
                        <!-- 账户信息 -->
                        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12"
                                Background="#CCFFFFFF">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="账户信息" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="学  号:" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Name="code" FontSize="14" Padding="3" 
                                             PreviewTextInput="Code_PreviewTextInput" InputMethod.IsInputMethodEnabled="False"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="密  码:" FontSize="14" VerticalAlignment="Center"/>
                                    <PasswordBox Grid.Row="1" Grid.Column="1" Name="secret" FontSize="14" Padding="3" 
                                                 InputMethod.IsInputMethodEnabled="False"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="运营商:" FontSize="14" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="2" Grid.Column="1" Name="carrier" FontSize="14" Padding="3"
                                              ItemsSource="{Binding Path=ComboxList,Mode=OneWay,Source={StaticResource carrierVM}}" 
                                              DisplayMemberPath="Text" SelectedValuePath="Key"/>
                                </Grid>
                            </Grid>
                        </Border>
                        
                        <StackPanel Grid.Row="3" Margin="0,0,0,15">
                            <Button Content="保存网络配置" Style="{StaticResource ModuleSaveButton}" Margin="0,0,0,8" Click="SaveNetworkConfiguration_Click"/>
                            <TextBlock x:Name="SettingsStatusText" TextWrapping="Wrap" FontSize="12" Foreground="#666"/>
                        </StackPanel>

                        <!-- 登录模式与选项 -->
                        <Grid Grid.Row="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="启动选项" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <StackPanel>
                                        <CheckBox Name="AutoRun" Margin="0,3" Checked="ImmediateOption_Changed" Unchecked="ImmediateOption_Changed">开机启动</CheckBox>
                                        <CheckBox Name="AutoLogin" Margin="0,3" Checked="ImmediateOption_Changed" Unchecked="ImmediateOption_Changed">启动时登录</CheckBox>
                                        <CheckBox Name="AutoMin" Margin="0,3" Checked="ImmediateOption_Changed" Unchecked="ImmediateOption_Changed">启动时收起</CheckBox>
                                        <CheckBox Name="SetLogin" Margin="0,3" Checked="ImmediateOption_Changed" Unchecked="ImmediateOption_Changed">定时检测</CheckBox>
                                        <CheckBox Name="PreventSleepCheckBox" Margin="0,3" Checked="ImmediateOption_Changed" Unchecked="ImmediateOption_Changed">阻止系统休眠</CheckBox>
                                        <CheckBox Name="PreventDisplaySleepCheckBox" Margin="0,3" Checked="ImmediateOption_Changed" Unchecked="ImmediateOption_Changed">阻止屏幕关闭</CheckBox>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="连接优先顺序" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <StackPanel>
                                        <RadioButton Name="campusFirst" GroupName="NetworkPriority" Margin="0,3" Checked="Priority_Changed">校园网优先</RadioButton>
                                        <RadioButton Name="dormitoryFirst" GroupName="NetworkPriority" Margin="0,3" Checked="Priority_Changed">宿舍网优先</RadioButton>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="定时时长:" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1" Name="loginTime" FontSize="14" Padding="3"
                                         TextChanged="Interval_TextChanged"
                                         PreviewTextInput="Code_PreviewTextInput" InputMethod.IsInputMethodEnabled="False"/>
                                <TextBlock Grid.Column="2" Text="秒" FontSize="14" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>
                            
                            <TextBlock Grid.Row="2" x:Name="IntervalValidationText" TextWrapping="Wrap" FontSize="12" Foreground="OrangeRed" Margin="0,0,0,8"/>
                        </Grid>
                    </Grid>
                    
                    <StackPanel Margin="0,8,0,0">
                        <CheckBox x:Name="EnhancedModeCheckBox" Content="增强模式"
                                  Checked="ImmediateOption_Changed" Unchecked="ImmediateOption_Changed"/>
                    </StackPanel>

                    <StackPanel x:Name="LoggingPanel" Margin="0,12,0,0">
                        <TextBlock Text="运行日志" FontWeight="Bold" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="单文件上限：" VerticalAlignment="Center"/>
                            <TextBox x:Name="LogFileSize" Width="60" Padding="3" TextChanged="LogFileSize_TextChanged"/>
                            <TextBlock Text=" MB（1～100）" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="LogSizeValidationText" Foreground="OrangeRed" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- 关于面板 -->
                    <Grid x:Name="AboutPanel" Margin="0,20,0,0">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,16">
                            <TextBlock Text="CPU_NET_Lite" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="校园网自动登录工具" FontSize="14" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock x:Name="VersionTextBlock" FontSize="13" Foreground="#666666" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                            <TextBlock Text="开发者：Halfaustus" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="基于 SoraNoNeko/cpu_net" FontSize="12" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock HorizontalAlignment="Center" Margin="0,0,0,20">
                                <Hyperlink Click="Hyperlink_Click" FontSize="14">Halfaustus/cpu_net_lite</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
            

        </Grid>
    </Grid>
</Page>
